<?xml version="1.0" ?>
<!--
  Label-only floor plate under TrashCanC_01 (footprint from the collision mesh bounds). The
  dumpster's body starts about 0.7 m up on wheels, but its collision mesh is solid from the floor,
  so floor seen under it is labelled pallet/box (3), not floor. Only the segmentation camera sees
  it (visibility_flags 2; the RGB camera's visibility_mask clears that bit). No collision.
  Include it with the same pose as the dumpster.
-->
<sdf version="1.9">
  <model name="bevnav_footprint_trashcan_c">
    <static>true</static>
    <link name="link">
      <visual name="plate">
        <pose>0 0 0.001 0 0 0</pose>
        <geometry>
          <box>
            <size>1.48 0.91 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>0.8 0.8 0.8 1</ambient>
          <diffuse>0.8 0.8 0.8 1</diffuse>
        </material>
        <visibility_flags>2</visibility_flags>
      </visual>
    </link>
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
      <label>3</label>
    </plugin>
  </model>
</sdf>
