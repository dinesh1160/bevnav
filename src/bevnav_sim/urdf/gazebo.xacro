<?xml version="1.0"?>
<!--
  gz-sim systems on the rover. Expects the property r (robot.yaml) from beetlebot.urdf.xacro.
  The diff-drive and ground-truth TF go to gz topics that bridge.yaml does not bridge, so the
  EKF (or gt_tf_relay_node) is the only owner of odom -> base_footprint.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${r.wheels.separation_m}</wheel_separation>
      <wheel_radius>${r.wheels.radius_m}</wheel_radius>
      <odom_publish_frequency>${r.odom_rate_hz}</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>model/beetlebot/diff_drive_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
    </plugin>

    <plugin filename="gz-sim-joint-position-controller-system"
            name="gz::sim::systems::JointPositionController">
      <joint_name>camera_pan_joint</joint_name>
      <topic>camera_pan/cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <p_gain>${r.pan.p_gain}</p_gain>
      <cmd_max>${r.pan.max_velocity_rad_s}</cmd_max>
      <cmd_min>${-r.pan.max_velocity_rad_s}</cmd_min>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <update_rate>${r.joint_state_rate_hz}</update_rate>
    </plugin>

    <!-- Ground truth (evaluation only): rover pose in the Gazebo world frame. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>gt/pose</odom_topic>
      <tf_topic>model/beetlebot/gt_tf</tf_topic>
      <odom_publish_frequency>${r.gt_pose_rate_hz}</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>
</robot>
