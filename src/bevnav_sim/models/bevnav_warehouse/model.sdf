<?xml version="1.0" ?>
<!--
  Static BEVNav warehouse: uniform floor plus the AWS RoboMaker models placed as in
  bcr_bot worlds/small_warehouse.sdf (poses unchanged; see ../ATTRIBUTION.md).
  Labels: floor 1, shelf 2, pallet/box/obstacle 3, person 4, wall/structure 5.
-->
<sdf version="1.9">
  <model name="bevnav_warehouse">
    <static>true</static>
    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>1</label>
      </plugin>
    </model>

    <include>
      <name>aws_robomaker_warehouse_RoofB_01_001</name>
      <pose>0.0 0.0 0 0 0 0</pose>
      <uri>model://aws_robomaker_warehouse_RoofB_01</uri>
