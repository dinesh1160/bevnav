<?xml version="1.0" ?>
<!-- BEVNav scenario F_D_dim. Narrow gap: scenario A with two boxes leaving a 0.6 m gap at y = -4.0.
     Lighting: dim. Warehouse: model://bevnav_warehouse (see ../../models/ATTRIBUTION.md). -->
<sdf version="1.9">
  <world name="F_D_dim">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light name="Warehouse_CeilingLight_003" type="point">
      <pose>0 0 9 0 0 0</pose>
      <diffuse>0.15 0.15 0.15 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>800</range>
        <constant>0.2</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
      <direction>0.1 0.1 -1</direction>
    </light>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.25 0.25 0.25 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://bevnav_warehouse</uri>
    </include>

    <include>
      <name>aisle_shelf_north</name>
      <pose>-2.1 -0.75 0 0 0 1.5708</pose>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>2</label>
      </plugin>
    </include>
    <include>
      <name>aisle_shelf_south</name>
      <pose>-2.1 -5.0 0 0 0 1.5708</pose>
      <uri>model://aws_robomaker_warehouse_ShelfE_01</uri>
      <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
        <label>2</label>
      </plugin>
    </include>
    <include>
      <name>gap_left</name>
      <pose>-4.19 -4.0 0 0 0 0</pose>
      <uri>model://bevnav_box</uri>
    </include>
    <include>
      <name>gap_right</name>
      <pose>-3.09 -4.0 0 0 0 0</pose>
      <uri>model://bevnav_box</uri>
    </include>
  </world>
</sdf>
