<?xml version="1.0" ?>
<!-- 0.5 m cardboard-coloured box for BEVNav scenarios; label 3 (pallet/box). -->
<sdf version="1.9">
  <model name="bevnav_box">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.25 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 0.5 0.5</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 0.5 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.45 0.3 1</ambient>
          <diffuse>0.6 0.45 0.3 1</diffuse>
        </material>
      </visual>
    </link>
    <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label">
      <label>3</label>
    </plugin>
  </model>
</sdf>
